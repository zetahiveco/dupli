{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "baseUrl": "./",
        "outDir": "./dist",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        ".next",
        "**/middleware.ts",
        "src/app",
        "src/components",
        "src/hooks",
        "src/lib/auth.ts",
        "**/tailwind.config.ts",
        "generated/**/*"
    ]
}